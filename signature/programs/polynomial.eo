(include "../theories/theory.eo")

; Polynomial normalization of arithmetic terms, ported from cvc5's Eunoia
; signature (proofs/eo/cpc/programs/PolyNorm.eo, programs/Utils.eo,
; programs/Arith.eo and rules/Arith.eo, cvc5 380c9796cb). It backs the Alethe
; rules `poly_simp` and `poly_simp_rel`, which cvc5 emits for its proof rules
; ARITH_POLY_NORM and ARITH_POLY_NORM_REL. The bit-vector half and the
; `/_total` case were left out; everything else is as in cvc5.
;
; cvc5 is copyright (C) 2009-2026 by its authors and contributors (see the file
; AUTHORS of cvc5) and their institutional affiliations. All rights reserved.
; Redistributed under the terms of cvc5's modified BSD license (see the file
; COPYING of cvc5).

; A monomial is a list of terms that are ordered by `$compare_var` and a
; rational coefficient. A polynomial is a list of monomials whose monomials are
; ordered by `$compare_var`.
(declare-const @@Monomial Type)
(define @Monomial () @@Monomial)
(declare-const @@mon (-> eo::List Real @Monomial))
(define @mon () @@mon)

(declare-const @@Polynomial Type)
(define @Polynomial () @@Polynomial)
(declare-const @@poly.zero @Polynomial)
(define @poly.zero () @@Polynomial)
(declare-const @@poly (-> @Monomial @Polynomial @Polynomial) :right-assoc-nil @poly.zero)
(define @poly () @@poly)

; define: $compare_var
; args:
; - a T: The first term to compare.
; - b U: The second term to compare.
; return: >
;   True if a should be considered before b in an ordering where a and b are
;   considered to be atomic variables.
; note: >
;   This method is used to have a canonical ordering of variables. The
;   variable ordering always returns true for the variable with the lower
;   hash.
(define $compare_var ((T Type :implicit) (U Type :implicit) (a T) (b U))
  (eo::cmp b a))

; define: $sgn
; args:
; - x T: The term to inspect. Assumed to be an arithmetic value.
; return: The sign of x: -1 if x < 0, 1 if x > 0, and 0 otherwise.
(define $sgn ((T Type :implicit) (x T))
  (eo::ite (eo::is_neg x) -1 (eo::ite (eo::is_neg (eo::neg x)) 1 0)))

; program: $poly_neg
; args:
; - p @Polynomial: The polynomial to negate.
; return: the negation of the given polynomial.
(program $poly_neg ((c Real) (a eo::List) (p @Polynomial :list))
  :signature (@Polynomial) @Polynomial
  (
    (($poly_neg @poly.zero)           @poly.zero)
    (($poly_neg (@poly (@mon a c) p)) (eo::cons @poly (@mon a (eo::neg c)) ($poly_neg p)))
  )
)

; program: $poly_add
; args:
; - p1 @Polynomial: The first polynomial to add.
; - p2 @Polynomial: The second polynomial to add.
; return: the addition of the given polynomials.
(program $poly_add ((c1 Real) (a1 eo::List) (c2 Real) (a2 eo::List) (p @Polynomial) (p1 @Polynomial :list) (p2 @Polynomial :list))
  :signature (@Polynomial @Polynomial) @Polynomial
  (
    (($poly_add (@poly (@mon a1 c1) p1) (@poly (@mon a2 c2) p2)) (eo::ite (eo::eq a1 a2)
                                                                  (eo::define ((ca (eo::add c1 c2)) (pa ($poly_add p1 p2)))
                                                                  ; check if cancels
                                                                  (eo::ite (eo::eq ca 0/1) pa (eo::cons @poly (@mon a1 ca) pa)))
                                                                (eo::ite ($compare_var a1 a2)
                                                                  (eo::cons @poly (@mon a1 c1) ($poly_add p1 (@poly (@mon a2 c2) p2)))
                                                                  (eo::cons @poly (@mon a2 c2) ($poly_add (@poly (@mon a1 c1) p1) p2)))))
    (($poly_add @poly.zero p)                                    p)
    (($poly_add p @poly.zero)                                    p)
  )
)

; program: $mvar_mul_mvar
; args:
; - a eo::List: The first monomial variable to multiply.
; - c eo::List: The second monomial variable to multiply.
; return: the multiplication of the given monomial variables.
(program $mvar_mul_mvar ((T Type) (U Type) (a1 T) (a2 eo::List :list) (c1 U) (c2 eo::List :list))
  :signature (eo::List eo::List) eo::List
  (
    (($mvar_mul_mvar (eo::List::cons a1 a2) (eo::List::cons c1 c2))
      (eo::ite ($compare_var a1 c1)
        (eo::cons eo::List::cons a1 ($mvar_mul_mvar a2 (eo::List::cons c1 c2)))
        (eo::cons eo::List::cons c1 ($mvar_mul_mvar (eo::List::cons a1 a2) c2))))
    (($mvar_mul_mvar a2 eo::List::nil)          a2)
    (($mvar_mul_mvar eo::List::nil c2)          c2)
  )
)

; program: $mon_mul_mon
; args:
; - a @Monomial: The first monomial to multiply.
; - b @Monomial: The second monomial to multiply.
; return: the multiplication of the given monomials.
(program $mon_mul_mon ((a1 eo::List) (a2 eo::List) (c1 Real) (c2 Real))
  :signature (@Monomial @Monomial) @Monomial
  (
    (($mon_mul_mon (@mon a1 c1) (@mon a2 c2))  (@mon ($mvar_mul_mvar a1 a2) (eo::mul c1 c2)))
  )
)

; program: $poly_mul_mon
; args:
; - a @Monomial: The monomial to multiply.
; - p @Polynomial: The polynomial to multiply.
; return: the multiplication of the polynomial by a monomial.
(program $poly_mul_mon ((m1 @Monomial) (m2 @Monomial) (p2 @Polynomial :list))
  :signature (@Monomial @Polynomial) @Polynomial
  (
    (($poly_mul_mon m1 (@poly m2 p2)) ($poly_add (@poly ($mon_mul_mon m1 m2)) ($poly_mul_mon m1 p2)))   ; NOTE: this amounts to an insertion sort
    (($poly_mul_mon m1 @poly.zero)    @poly.zero)
  )
)

; program: $poly_mul
; args:
; - p1 @Polynomial: The first polynomial to multiply.
; - p2 @Polynomial: The second polynomial to multiply.
; return: the multiplication of the given polynomials.
(program $poly_mul ((m @Monomial) (p1 @Polynomial :list) (p @Polynomial))
  :signature (@Polynomial @Polynomial) @Polynomial
  (
    (($poly_mul (@poly m p1) p) ($poly_add ($poly_mul_mon m p) ($poly_mul p1 p)))
    (($poly_mul @poly.zero p)   @poly.zero)
    (($poly_mul p @poly.zero)   @poly.zero)
  )
)

; define: $get_arith_poly_norm_div
; args:
; - a1 T: The numerator to process of type Int or Real.
; - a1p @Polynomial: The normalization of a1.
; - a2 T: The denominator to process of type Int or Real.
; return: >
;   The polynomial corresponding to the (normalized) form of (/ a1 a2).
(define $get_arith_poly_norm_div ((U Type :implicit) (V Type :implicit) (a1 U) (a1p @Polynomial) (a2 V))
  (eo::define ((a2q (eo::to_q a2)))
  (eo::ite (eo::ite (eo::is_q a2q) (eo::not (eo::eq a2q 0/1)) false)
    ; if division by non-zero constant, we normalize
    ($poly_mul_mon (@mon eo::List::nil (eo::qdiv 1/1 a2q)) a1p)
    ; otherwise it is treated as a variable
    (@poly (@mon (eo::List::cons (/ a1 a2)) 1/1)))))

; program: $get_arith_poly_norm
; args:
; - a T: The arithmetic term to process of type Int or Real.
; return: the polynomial corresponding to the (normalized) form of a.
(program $get_arith_poly_norm ((T Type) (U Type) (V Type) (a T) (a1 U) (a2 V :list))
  :signature (T) @Polynomial
  (
    (($get_arith_poly_norm (- a1))          ($poly_neg ($get_arith_poly_norm a1)))
    (($get_arith_poly_norm (+ a1 a2))       ($poly_add ($get_arith_poly_norm a1) ($get_arith_poly_norm a2)))
    (($get_arith_poly_norm (- a1 a2))       ($poly_add ($get_arith_poly_norm a1) ($poly_neg ($get_arith_poly_norm a2))))
    (($get_arith_poly_norm (* a1 a2))       ($poly_mul ($get_arith_poly_norm a1) ($get_arith_poly_norm a2)))
    (($get_arith_poly_norm (/ a1 a2))       ($get_arith_poly_norm_div a1 ($get_arith_poly_norm a1) a2))
    (($get_arith_poly_norm (to_real a1))    ($get_arith_poly_norm a1))
    (($get_arith_poly_norm a)               (eo::define ((aq (eo::to_q a)))
                                            ; check if a is a constant (Int or Real)
                                            (eo::ite (eo::is_q aq)
                                              ; if it is zero, it cancels, otherwise it is 1 with itself as coefficient
                                              (eo::ite (eo::is_eq aq 0/1)
                                                @poly.zero
                                                (@poly (@mon eo::List::nil aq)))
                                            (@poly (@mon (eo::List::cons a) 1/1)))))    ; introduces list
  )
)

; program: $is_poly_norm_rel_consts_rel
; args:
; - b Bool: >
;   a formula of the form (r cx cy) where r is a binary relation and cx and
;   cy are scaling factors.
; return: >
;   The result of checking if r is a polynomial normalization relation for a
;   formula of the form (= (r x1 x2) (r y1 y2)), where it is already known that
;   (= (* cx (- x1 x2)) (* cy (- y1 y2))). If r is any of <, <=, >=, or >, the
;   scaling factors must have the same sign. Returns false for any relation
;   except the previously mentioned ones and =.
(program $is_poly_norm_rel_consts_rel ((T Type) (cx T) (cy T) (b Bool))
  :signature (Bool) Bool
  (
    (($is_poly_norm_rel_consts_rel (< cx cy))  (eo::eq ($sgn cx) ($sgn cy)))
    (($is_poly_norm_rel_consts_rel (<= cx cy)) (eo::eq ($sgn cx) ($sgn cy)))
    (($is_poly_norm_rel_consts_rel (= cx cy))  true)
    (($is_poly_norm_rel_consts_rel (>= cx cy)) (eo::eq ($sgn cx) ($sgn cy)))
    (($is_poly_norm_rel_consts_rel (> cx cy))  (eo::eq ($sgn cx) ($sgn cy)))
    (($is_poly_norm_rel_consts_rel b)          false)
  )
)

; program: $is_poly_norm_rel_consts
; args:
; - b Bool: >
;   a formula of the form (r cx cy) where r is a binary relation and cx and
;   cy are scaling factors.
; return: >
;   The result of checking if r is a polynomial normalization relation for a
;   formula of the form (= (r x1 x2) (r y1 y2)), where it is already known that
;   (= (* cx (- x1 x2)) (* cy (- y1 y2))). If r is any of <, <=, >=, or >, the
;   scaling factors must have the same sign. cx and cy must be non-zero for any
;   relation previously mentioned and =. Returns false for any other relation.
(program $is_poly_norm_rel_consts ((T Type) (r (-> T T Bool)) (cx T) (cy T))
  :signature (Bool) Bool
  (
  (($is_poly_norm_rel_consts (r cx cy))
    (eo::and (eo::not (eo::or (eo::eq (eo::to_q cx) 0/1) (eo::eq (eo::to_q cy) 0/1)))
      ($is_poly_norm_rel_consts_rel (r cx cy))))
  )
)

; program: $is_eq_maybe_to_real
; args:
; - x U: The term to check.
; - y T: The target term.
; return: >
;   True if x is syntactically equal to y, possibly removing an application of
;   to_real.
(program $is_eq_maybe_to_real ((U Type) (x U) (T Type))
  :signature (U T) Bool
  (
  (($is_eq_maybe_to_real x x)           true)
  (($is_eq_maybe_to_real (to_real x) x) true)
  )
)
