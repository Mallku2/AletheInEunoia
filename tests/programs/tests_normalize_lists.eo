(include "../../signature/programs/lists.eo")

(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(declare-const U Type)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-const d U)

; The normalizer retains the complete spine. Singleton elimination belongs
; to the caller.
(define associative-spine ()
  ($normalize_eo_list Bool Bool or (eo::List::cons p)) :is_eq (or p))

; Empty lists use the consuming operator's nil; singletons lose only the
; outer application. An explicit nil-valued operand is still an operand.
(define or-empty ()
  (eo::list_singleton_elim or ($normalize_eo_list Bool Bool or eo::List::nil)) :is_eq false)
(define and-empty ()
  (eo::list_singleton_elim and ($normalize_eo_list Bool Bool and eo::List::nil)) :is_eq true)
(define or-one ()
  (eo::list_singleton_elim or ($normalize_eo_list Bool Bool or (eo::List::cons p))) :is_eq p)
(define and-one ()
  (eo::list_singleton_elim and ($normalize_eo_list Bool Bool and (eo::List::cons p))) :is_eq p)
(define or-two ()
  (eo::list_singleton_elim or ($normalize_eo_list Bool Bool or (eo::List::cons p false)))
  :is_eq (or p false))
(define and-two ()
  (eo::list_singleton_elim and ($normalize_eo_list Bool Bool and (eo::List::cons p true)))
  :is_eq (and p true))
(define or-three ()
  (eo::list_singleton_elim or ($normalize_eo_list Bool Bool or (eo::List::cons p q false)))
  :is_eq (or p q false))
(define or-nested ()
  (eo::list_singleton_elim or ($normalize_eo_list Bool Bool or (eo::List::cons p (or q r))))
  :is_eq (or p (or q r)))
(define repeated-operands ()
  (eo::list_singleton_elim and ($normalize_eo_list Bool Bool and (eo::List::cons p q p)))
  :is_eq (and p q p))
(define add-empty ()
  (eo::list_singleton_elim + ($normalize_eo_list Int Int + eo::List::nil)) :is_eq 0)
(define multiply-empty ()
  (eo::list_singleton_elim * ($normalize_eo_list Int Int * eo::List::nil)) :is_eq 1)
(define add-single ()
  (eo::list_singleton_elim + ($normalize_eo_list Int Int + (eo::List::cons 2))) :is_eq 2)
(define add-two ()
  (eo::list_singleton_elim + ($normalize_eo_list Int Int + (eo::List::cons 2 0))) :is_eq (+ 2 0))

; :list fragments become concatenations during parsing and are evaluated
; before normalization. Empty fragments disappear; nested formulas do not.
(define join ((xs eo::List :list) (ys eo::List :list))
  (eo::list_singleton_elim or ($normalize_eo_list Bool Bool or (eo::List::cons xs p ys false))))
(define concat-empty () (join eo::List::nil eo::List::nil)
  :is_eq (or p false))
(define concat-many () (join (eo::List::cons q r) (eo::List::cons p))
  :is_eq (or q r p p false))
(define concat-nested () (join (eo::List::cons (or q r)) eo::List::nil)
  :is_eq (or (or q r) p false))

; Reusing the normalizer with the carrier constructor preserves every
; element, and validates lists even if the rule's conclusion ignores them.
(define carrier-empty ()
  ($normalize_eo_list U eo::List eo::List::cons eo::List::nil)
  :is_eq eo::List::nil)
(define carrier-single ()
  ($normalize_eo_list U eo::List eo::List::cons (eo::List::cons a))
  :is_eq (eo::List::cons a))
(define carrier-many ()
  ($normalize_eo_list U eo::List eo::List::cons (eo::List::cons a b a))
  :is_eq (eo::List::cons a b a))
(define bad-carrier ()
  (eo::is_ok ($normalize_eo_list U eo::List eo::List::cons (eo::List::cons a true)))
  :is_eq false)
(define bad-assoc ()
  (eo::is_ok ($normalize_eo_list Bool Bool or (eo::List::cons a)))
  :is_eq false)
