; shuffle
;-----------------

; Some constants to build terms, for testing purposes.
(declare-const a Int)
(declare-const b Int)
(declare-const d Bool)
(declare-const e Bool)


; +
(step $test_$check_shuffle_1 
      (@cl (= (+ 1 2) (+ 2 1)))
      :rule shuffle)

(step $test_$check_shuffle_4 
      (@cl (= (+ a b 3) (+ 3 b a)))
      :rule shuffle)

(step $test_$check_shuffle_6 
      (@cl (= (+ a b 2 3) (+ b 3 2 a)))
      :rule shuffle)

; *
(step $test_$check_shuffle_8 
      (@cl (= (* a 2) (* 2 a)))
      :rule shuffle)

(step $test_$check_shuffle_11 
      (@cl (= (* a 2 3) (* 3 2 a)))
      :rule shuffle)

(step $test_$check_shuffle_13 
      (@cl (= (* a b 2 3) (* b 3 2 a)))
      :rule shuffle)

; or
(step $test_$check_shuffle_14 
      (@cl (= (or true c) (or c true)))
      :rule shuffle)

(step $test_$check_shuffle_17 
      (@cl (= (or true c d) (or d c true)))
      :rule shuffle)

(step $test_$check_shuffle_19 
      (@cl (= (or true c c d) (or c d c true)))
      :rule shuffle)

; and
(step $test_$check_shuffle_20 
      (@cl (= (and true c) (and c true)))
      :rule shuffle)

(step $test_$check_shuffle_23 
      (@cl (= (and true c d) (and d c true)))
      :rule shuffle)

(step $test_$check_shuffle_25 
      (@cl (= (and true c c d) (and c d c true)))
      :rule shuffle)

