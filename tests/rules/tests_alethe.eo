(step $test_bfun_elim_8
      (@cl (exists ((y1 Int)) 
              (or (or false false false)
                  (or true false false)
                  (or false true false)
                  (or true true false)
                  (or false false true)
                  (or true false true)
                  (or false true true)
                  (or true true true))))
      :rule bfun_elim
      :premises (premise_8))

(assume premise_9 (@cl (exists ((x1 Bool) (x2 Bool) (y1 Int)
                         (x3 Bool))
                        (and x1 x2 x3))))
(step $test_bfun_elim_9
      (@cl (exists ((y1 Int)) 
              (or (and false false false)
