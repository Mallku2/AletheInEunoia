; $build_boolean_interval_varlist_form
;--------------------------------------------

(step $test_$build_boolean_interval_varlist_form_1 true 
      :rule $assert_eq 
      :args (($build_boolean_interval_varlist_form 0 1 1)

             (@varlist (@varlist false))))

(step $test_$build_boolean_interval_varlist_form_2 true 
      :rule $assert_eq 
      :args (($build_boolean_interval_varlist_form 0 2 1)

             (@varlist (@varlist false)
                       (@varlist true))))

(step $test_$build_boolean_interval_varlist_form_3 true 
      :rule $assert_eq 
      :args (($build_boolean_interval_varlist_form 0 3 2)

             (@varlist (@varlist false false)
                       (@varlist true false)
                       (@varlist false true))))

(step $test_$build_boolean_interval_varlist_form_4 true 
      :rule $assert_eq 
      :args (($build_boolean_interval_varlist_form 0 4 2)

             (@varlist (@varlist false false)
                       (@varlist true false)
                       (@varlist false true)
                       (@varlist true true))))

(step $test_$build_boolean_interval_varlist_form_5 true 
      :rule $assert_eq 
      :args (($build_boolean_interval_varlist_form 0 5 3)

             (@varlist (@varlist false false false)
                       (@varlist true false false)
                       (@varlist false true false)
                       (@varlist true true false)
                       (@varlist false false true))))

(step $test_$build_boolean_interval_varlist_form_6 true 
      :rule $assert_eq 
      :args (($build_boolean_interval_varlist_form 1 5 3)

             (@varlist (@varlist true false false)
                       (@varlist false true false)
                       (@varlist true true false)
                       (@varlist false false true))))

(step $test_$build_boolean_interval_varlist_form_7 true 
      :rule $assert_eq 
      :args (($build_boolean_interval_varlist_form 2 5 3)

             (@varlist (@varlist false true false)
                       (@varlist true true false)
                       (@varlist false false true))))

(step $test_$build_boolean_interval_varlist_form_8 true 
      :rule $assert_eq 
      :args (($build_boolean_interval_varlist_form 3 5 3)

             (@varlist (@varlist true true false)
                       (@varlist false false true))))

(step $test_$build_boolean_interval_varlist_form_9 true 
      :rule $assert_eq 
      :args (($build_boolean_interval_varlist_form 4 5 3)

             (@varlist (@varlist false false true))))

(step $test_$build_boolean_interval_varlist_form_10 true 
      :rule $assert_eq 
      :args (($build_boolean_interval_varlist_form 5 5 3)

             @varlist.nil))


;-------------------------------------
; $instantiate_specific_bool_variables
;-------------------------------------

(define x1 () (eo::var "x1" Bool))
(define x2 () (eo::var "x2" Int))
(define x3 () (eo::var "x3" Bool))

(step $test_$instantiate_specific_bool_variables_1 true 
      :rule $assert_eq 
      :args (($instantiate_specific_bool_variables x1 
                                          (@varlist 
                                           (@varlist ($f_list_cons @varlist x1 false)))
                                          forall)

             (and false)))

(step $test_$instantiate_specific_bool_variables_2 true 
      :rule $assert_eq 
      :args (($instantiate_specific_bool_variables (or x1 x2)
                                          (@varlist 
                                           (@varlist ($f_list_cons @varlist x1 false)
                                                     ($f_list_cons @varlist x2 false))
                                           (@varlist ($f_list_cons @varlist x1 true)
                                                     ($f_list_cons @varlist x2 false)))
                                          forall)

             ($f_list_cons and 
                           (or false false)
                           ($f_list_cons and (or true false) true))))

(step $test_$instantiate_specific_bool_variables_3 true 
      :rule $assert_eq 
      :args (($instantiate_specific_bool_variables (or x1 x2)
                                          (@varlist 
                                           (@varlist ($f_list_cons @varlist x1 false)
                                                     ($f_list_cons @varlist x2 false))
                                           (@varlist ($f_list_cons @varlist x1 true)
                                                     ($f_list_cons @varlist x2 false))
                                           (@varlist ($f_list_cons @varlist x1 false)
                                                     ($f_list_cons @varlist x2 true))
                                           (@varlist ($f_list_cons @varlist x1 true)
                                                     ($f_list_cons @varlist x2 true)))
                                          forall)

             ($f_list_cons and 
                           (or false false)
                           ($f_list_cons and 
                                         (or true false)
                                         ($f_list_cons and 
                                                       (or false true)
                                                       ($f_list_cons and 
                                                                     (or true true)
                                                                     true))))))

(step $test_$instantiate_specific_bool_variables_4 true 
      :rule $assert_eq 
      :args (($instantiate_specific_bool_variables (or x1 x2)
                                          (@varlist 
                                           (@varlist ($f_list_cons @varlist x1 false)
                                                     ($f_list_cons @varlist x2 false))
                                           (@varlist ($f_list_cons @varlist x1 true)
                                                     ($f_list_cons @varlist x2 false))
                                           (@varlist ($f_list_cons @varlist x1 false)
                                                     ($f_list_cons @varlist x2 true))
                                           (@varlist ($f_list_cons @varlist x1 true)
                                                     ($f_list_cons @varlist x2 true)))
                                          exists)

             ($f_list_cons or 
                           (or false false)
                           ($f_list_cons or 
                                         (or true false)
                                         ($f_list_cons or 
                                                       (or false true)
                                                       ($f_list_cons or 
                                                                     (or true true)
                                                                     false))))))


;-------------------------------------
; $instantiate_bool_variables
;-------------------------------------

(define x1 () (eo::var "x1" Bool))
(define x2 () (eo::var "x2" Int))
(define x3 () (eo::var "x3" Bool))
(define y1 () (eo::var "y1" Int))

(step $test_$instantiate_bool_variables_1 true 
      :rule $assert_eq 
      :args (($instantiate_bool_variables (forall ((x1 Bool)) x1))

             (and false true)))

(step $test_$instantiate_bool_variables_2 true 
      :rule $assert_eq 
      :args (($instantiate_bool_variables (forall ((x1 Bool) (x2 Bool)) (or x1 x2)))

             (and (or false false)
                  (or true false)
                  (or false true)
                  (or true true))))

(step $test_$instantiate_bool_variables_3 true 
      :rule $assert_eq 
      :args (($instantiate_bool_variables (forall ((x1 Bool) (y1 Int) (x2 Bool)) 
                                                  (or x1 x2)))

             (forall ((y1 Int)) 
                     (and (or false false)
                          (or true false)
                          (or false true)
                          (or true true)))))

(step $test_$instantiate_bool_variables_4 true 
      :rule $assert_eq 
      :args (($instantiate_bool_variables (forall ((x1 Bool) (x2 Bool) (y1 Int)) 
                                                  (or x1 x2)))

             (forall ((y1 Int)) 
                     (and (or false false)
                          (or true false)
                          (or false true)
                          (or true true)))))

(step $test_$instantiate_bool_variables_5 true 
      :rule $assert_eq 
      :args (($instantiate_bool_variables (forall ((x1 Bool) (x2 Bool) (y1 Int)
                                                   (x3 Bool))
                                                  (or x1 x2 x3)))

             (forall ((y1 Int)) 
                     (and (or false false false)
                          (or true false false)
                          (or false true false)
                          (or true true false)
                          (or false false true)
                          (or true false true)
                          (or false true true)
                          (or true true true)))))

(step $test_$instantiate_bool_variables_6 true 
      :rule $assert_eq 
      :args (($instantiate_bool_variables (exists ((x1 Bool) (x2 Bool) (y1 Int)
                                              (x3 Bool))
                                             (or x1 x2 x3)))

             (exists ((y1 Int)) 
                (or (or false false false)
                    (or true false false)
                    (or false true false)
                    (or true true false)
                    (or false false true)
                    (or true false true)
                    (or false true true)
                    (or true true true)))))

(step $test_$instantiate_bool_variables_6 true 
      :rule $assert_eq 
      :args (($instantiate_bool_variables (exists ((x1 Bool) (x2 Bool) (y1 Int)
                                              (x3 Bool))
                                             (and x1 x2 x3)))
             
             (exists ((y1 Int)) 
                (or (and false false false)
                    (and true false false)
                    (and false true false)
                    (and true true false)
                    (and false false true)
                    (and true false true)
                    (and false true true)
                    (and true true true)))))

(step $test_$instantiate_bool_variables_7 true 
      :rule $assert_eq 
      :args (($instantiate_bool_variables (exists ((x1 Bool) (x2 Bool) (y1 Int)
                                              (y2 Int) (x3 Bool))
                                             (or (= y1 y2) (and x1 x2 x3))))
             
             (exists ((y1 Int) (y2 Int)) 
                (or (or (= y1 y2) (and false false false))
                    (or (= y1 y2) (and true false false))
                    (or (= y1 y2) (and false true false))
                    (or (= y1 y2) (and true true false))
                    (or (= y1 y2) (and false false true))
                    (or (= y1 y2) (and true false true))
                    (or (= y1 y2) (and false true true))
                    (or (= y1 y2) (and true true true))))))

;-----------------------------
; $extract_function_applied
;-----------------------------

(declare-const f (-> Bool Int))
(declare-const g (-> Int Bool Int))
(declare-const h (-> Bool Int Bool))
(declare-const j (-> Bool Int Bool Int))
(define x () (eo::var "x" Bool))
(define y () (eo::var "y" Int))
(define z () (eo::var "z" Bool))

(step $test_$extract_function_applied_1 true 
      :rule $assert_eq 
      :args (($extract_function_applied (f x))
             
             f))

(step $test_$extract_function_applied_2 true 
      :rule $assert_eq 
      :args (($extract_function_applied (g y x))
             
             g))

(step $test_$extract_function_applied_3 true 
      :rule $assert_eq 
      :args (($extract_function_applied (h x (g y x)))
             
             h))

(step $test_$extract_function_applied_4 true 
      :rule $assert_eq 
      :args (($extract_function_applied (j x (g y x) z))
             
             j))

(step $test_$extract_function_applied_5 true 
      :rule $assert_eq 
      :args (($extract_function_applied (j (h x (g y x)) (g y x) z))
             
             j))

(step $test_$extract_function_applied_6 true 
      :rule $assert_eq 
      :args (($extract_function_applied (j (h x (g y x)) (g y x) (h x (g y x))))
             
             j))

(step $test_$extract_function_applied_6 true 
      :rule $assert_eq 
      :args (($extract_function_applied (j (h x (g y x)) (g y x) (h x (g y x))))
             
             j))

;--------------------------
; $next_parameter
;--------------------------

(declare-const f (-> Bool Int))
(declare-const g (-> Int Bool Int))
(declare-const h (-> Bool Int Bool))
(declare-const j (-> Bool Int Bool Int))
(define x () (eo::var "x" Bool))
(define y () (eo::var "y" Int))
(define z () (eo::var "z" Bool))

(step $test_$next_parameter_1 true 
      :rule $assert_eq 
      :args (($next_parameter f (f x))
             
             x))

(step $test_$next_parameter_2 true 
      :rule $assert_eq 
      :args (($next_parameter g (g y))
             
             y))

(step $test_$next_parameter_3 true 
      :rule $assert_eq 
      :args (($next_parameter (g y) (g y x))
             
             x))

(step $test_$next_parameter_4 true 
      :rule $assert_eq 
      :args (($next_parameter g (g y x))

             y))

(step $test_$next_parameter_5 true 
      :rule $assert_eq 
      :args (($next_parameter j (j x y z))
             
             x))

(step $test_$next_parameter_6 true 
      :rule $assert_eq 
      :args (($next_parameter (j x) (j x y z))
             
             y))

(step $test_$next_parameter_7 true 
      :rule $assert_eq 
      :args (($next_parameter (j x y) (j x y z))
             
             z))

;------------------------------------
; $substitute_in_function_application_rec
;------------------------------------

(declare-const f (-> Bool Int))
(declare-const g (-> Int Bool Int))
(declare-const h (-> Bool Int Bool))
(declare-const j (-> Bool Int Bool Int))
(define x () (eo::var "x" Bool))
(define y () (eo::var "y" Int))
(define z () (eo::var "z" Bool))

(step $test_$substitute_in_function_application_rec_1 true 
      :rule $assert_eq 
      :args (($substitute_in_function_application_rec (f x) f x true (f x) (f x))
             
             (f true)))

(step $test_$substitute_in_function_application_rec_2 true 
      :rule $assert_eq 
      :args (($substitute_in_function_application_rec (g y) g y 10 (g y x) (g y))
             
             (g 10 x)))

(step $test_$substitute_in_function_application_rec_3 true 
      :rule $assert_eq 
      :args (($substitute_in_function_application_rec (g 10 x) (g 10) x false (g y x) 
                                                  (g y x))
             
             (g 10 false)))

(step $test_$substitute_in_function_application_rec_4 true 
      :rule $assert_eq 
      :args (($substitute_in_function_application_rec (h x) h x false (h x y) (h x))
             
             (h false y)))

(step $test_$substitute_in_function_application_rec_5 true 
      :rule $assert_eq 
      :args (($substitute_in_function_application_rec (h false y) (h false) y 3 
                                                  (h x y) (h x y))
             
             (h false 3)))

(step $test_$substitute_in_function_application_rec_6 true 
      :rule $assert_eq 
      :args (($substitute_in_function_application_rec (j x) j x true (j x y z) (j x))
             
             (j true y z)))

(step $test_$substitute_in_function_application_rec_7 true 
      :rule $assert_eq 
      :args (($substitute_in_function_application_rec (j true y) (j true) y 5 
                                                  (j x y z) (j x y))
             
             (j true 5 z)))

(step $test_$substitute_in_function_application_rec_8 true 
      :rule $assert_eq 
      :args (($substitute_in_function_application_rec (j true 5 z) (j true 5) z false 
                                                  (j x y z) (j x y z))
             
             (j true 5 false)))

;-------------------------------
; $traverse_function_application
;-------------------------------

(declare-const f (-> Bool Int))
(declare-const g (-> Int Bool Int))
(declare-const h (-> Bool Int Bool))
(declare-const j (-> Bool Int Bool Int))
(define x () (eo::var "x" Bool))
(define y () (eo::var "y" Int))
(define z () (eo::var "z" Bool))

(step $test_$traverse_function_application_1 true 
      :rule $assert_eq 
      :args (($traverse_function_application f (f x) (f x))
             
             (ite x (f true) (f false))))

(step $test_$traverse_function_application_2 true 
      :rule $assert_eq 
      :args (($traverse_function_application g (g y) (g y z))
             
             (ite z (g y true) (g y false))))

(step $test_$traverse_function_application_2b true 
      :rule $assert_eq 
      :args (($traverse_function_application (g y) (g y z) (g y z))
             
             (ite z (g y true) (g y false))))

(step $test_$traverse_function_application_3 true 
      :rule $assert_eq 
      :args (($traverse_function_application h (h x) (h x y))
             
             (ite x (h true y) (h false y))))

(step $test_$traverse_function_application_4 true 
      :rule $assert_eq 
      :args (($traverse_function_application j (j x) (j x y z))
             
             (ite x 
                  (ite z (j true y true) (j true y false)) 
                  (ite z (j false y true) (j false y false)))))

(step $test_$traverse_function_application_5 true 
      :rule $assert_eq 
      :args (($traverse_function_application j (j (h x y)) (j (h x y) y z))
             
             (ite (h x y)
                  (ite z (j true y true) (j true y false)) 
                  (ite z (j false y true) (j false y false)))))

;-----------------------------
; $instantiate_bool_parameters
;-----------------------------

(declare-const f (-> Bool Int))
(declare-const g (-> Int Bool Int))
(declare-const h (-> Bool Int Int))
(declare-const j (-> Bool Int Bool Int))
(define x () (eo::var "x" Bool))
(define y () (eo::var "y" Int))
(define z () (eo::var "z" Bool))

(step $test_$instantiate_bool_parameters_1 true 
      :rule $assert_eq 
      :args (($instantiate_bool_parameters (f x))
             
             (ite x (f true) (f false))))

(step $test_$instantiate_bool_parameters_2 true 
      :rule $assert_eq 
      :args (($instantiate_bool_parameters (g y x))
             
             (ite x (g y true) (g y false))))

(step $test_$instantiate_bool_parameters_3 true 
      :rule $assert_eq 
      :args (($instantiate_bool_parameters (h x y))
             
             (ite x (h true y) (h false y))))

(step $test_$instantiate_bool_parameters_4 true 
      :rule $assert_eq 
      :args (($instantiate_bool_parameters (j x y z))
             
             (ite x 
                  (ite z (j true y true) (j true y false))
                  (ite z (j false y true) (j false y false)))))

;-------------------------------------
; $instantiate_bool_terms_rec
;-------------------------------------

(define x1 () (eo::var "x1" Bool))
(define x2 () (eo::var "x2" Int))
(define x3 () (eo::var "x3" Bool))
(define y1 () (eo::var "y1" Int))

; Quantifications
(step $test_$instantiate_bool_terms_rec_1 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (forall ((x1 Bool)) x1))

             (and false true)))

(step $test_$instantiate_bool_terms_rec_1b true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec x1)

             x1))

(step $test_$instantiate_bool_terms_rec_1c true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (or x1 x3))

             (or x1 x3)))

(step $test_$instantiate_bool_terms_rec_2 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (forall ((x1 Bool) (x2 Bool)) (or x1 x2)))

             (and (or false false)
                  (or true false)
                  (or false true)
                  (or true true))))

(step $test_$instantiate_bool_terms_rec_3 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (forall ((x1 Bool) (y1 Int) (x2 Bool)) 
                                                      (or x1 x2)))
             
             (forall ((y1 Int)) 
                     (and (or false false)
                          (or true false)
                          (or false true)
                          (or true true)))))

(step $test_$instantiate_bool_terms_rec_4 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (forall ((x1 Bool) (x2 Bool) (y1 Int)) 
                                                      (or x1 x2)))

             (forall ((y1 Int)) 
                     (and (or false false)
                          (or true false)
                          (or false true)
                          (or true true)))))

(step $test_$instantiate_bool_terms_rec_5 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (forall ((x1 Bool) (x2 Bool) (y1 Int)
                                                       (x3 Bool))
                                                      (or x1 x2 x3)))

             (forall ((y1 Int)) 
                     (and (or false false false)
                          (or true false false)
                          (or false true false)
                          (or true true false)
                          (or false false true)
                          (or true false true)
                          (or false true true)
                          (or true true true)))))

(step $test_$instantiate_bool_terms_rec_6 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (exists ((x1 Bool) (x2 Bool) (y1 Int)
                                                  (x3 Bool))
                                                 (or x1 x2 x3)))

             (exists ((y1 Int)) 
                (or (or false false false)
                    (or true false false)
                    (or false true false)
                    (or true true false)
                    (or false false true)
                    (or true false true)
                    (or false true true)
                    (or true true true)))))

(step $test_$instantiate_bool_terms_rec_6 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (exists ((x1 Bool) (x2 Bool) (y1 Int)
                                              (x3 Bool))
                                             (and x1 x2 x3)))
             
             (exists ((y1 Int)) 
                (or (and false false false)
                    (and true false false)
                    (and false true false)
                    (and true true false)
                    (and false false true)
                    (and true false true)
                    (and false true true)
                    (and true true true)))))

(step $test_$instantiate_bool_terms_rec_7 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (exists ((x1 Bool) (x2 Bool) (y1 Int)
                                              (y2 Int) (x3 Bool))
                                             (or (= y1 y2) (and x1 x2 x3))))
             
             (exists ((y1 Int) (y2 Int)) 
                (or (or (= y1 y2) (and false false false))
                    (or (= y1 y2) (and true false false))
                    (or (= y1 y2) (and false true false))
                    (or (= y1 y2) (and true true false))
                    (or (= y1 y2) (and false false true))
                    (or (= y1 y2) (and true false true))
                    (or (= y1 y2) (and false true true))
                    (or (= y1 y2) (and true true true))))))

(step $test_$instantiate_bool_terms_rec_8 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (and true
                                                   (exists ((x1 Bool) (x2 Bool) (y1 Int)
                                                       (y2 Int) (x3 Bool))
                                                      (or (= y1 y2) (and x1 x2 x3)))))
             
             (and true
                  (exists ((y1 Int) (y2 Int)) 
