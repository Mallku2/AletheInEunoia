(include "../../signature/rules/alethe.eo")
(include "../unit_test_services.eo")


; Unit tests for rules that introduce tautologies.

;------------------------------------------
; $ite_intro_check_conjuncts
;------------------------------------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_$ite_intro_check_conjuncts_1 true 
      :rule $assert_eq 
      :args (($ite_intro_check_conjuncts (@varlist (ite a b c))
                                         (and (ite a
                                                   (= (ite a b c) b) 
                                                   (= (ite a b c) c))))

             true))

(step $test_$ite_intro_check_conjuncts_2 true 
      :rule $assert_eq 
      :args (($ite_intro_check_conjuncts (@varlist (ite (p f1) f4 f2))
                                         (and (ite (p f1)
                                                   (= (ite (p f1) f4 f2) f4) 
                                                   (= (ite (p f1) f4 f2) f2))))

             true))

;---------------
; $get_ite_terms
;---------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_$get_ite_terms_1 true 
      :rule $assert_eq 
      :args (($get_ite_terms (not (= b (ite c b a))))

             (@varlist (ite c b a))))

(step $test_$get_ite_terms_2 true 
      :rule $assert_eq 
      :args (($get_ite_terms (=> (and (p f1) 
                                     (or (= f1 f2) 
                                         (not (= (ite (p f1) f4 f2) f3)))) 
                                (p f3)))

             (@varlist (ite (p f1) f4 f2))))

(step $test_$get_ite_terms_3 true 
      :rule $assert_eq 
      :args (($get_ite_terms (= a
                                (ite b
                                     (ite c a b)
                                     (ite c b a))))

             (@varlist (ite b (ite c a b) (ite c b a))
                       (ite c a b)
                       (ite c b a))))

;-----------------
; $check_ite_intro
;-----------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_$check_ite_intro_1 true 
      :rule $assert_eq 
      :args (($check_ite_intro (not (= b (ite c b a)))
                               (not (= b (ite c b a)))
                               (and (ite c 
                                         (= (ite c b a) b) 
                                         (= (ite c b a) a))))

             true))

(step $test_$check_ite_intro_2 true 
      :rule $assert_eq 
      :args (($check_ite_intro 
              (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))

              (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))

              (and (ite (p f1)
                        (= (ite (p f1) f4 f2) f4) 
                        (= (ite (p f1) f4 f2) f2))))

             true))

(declare-const C_tt Bool) 
(declare-const C_tf Bool) 
(declare-const C_ft Bool) 
(declare-const C_ff Bool)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)  

(step $test_$check_ite_intro_3 true 
      :rule $assert_eq 
      :args (($check_ite_intro 
              (= a
                 (ite b
                      (ite c C_tt C_tf)
                      (ite c C_ft C_ff)))

              (= a
                 (ite b
                      (ite c C_tt C_tf)
                      (ite c C_ft C_ff)))

              (and (ite b
                        (= (ite c C_tt C_tf)
                           (ite b
                                (ite c C_tt C_tf)
                                (ite c C_ft C_ff)))
                        (= (ite c C_ft C_ff)
                           (ite b
                                (ite c C_tt C_tf)
                                (ite c C_ft C_ff))))

                   (ite c
                        (= C_tt (ite c C_tt C_tf))
                        (= C_tf (ite c C_tt C_tf)))

                   (ite c
                        (= C_ft (ite c C_ft C_ff))
                        (= C_ff (ite c C_ft C_ff))))
              )

             true)
)

;-----------------
; ite_intro
;-----------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const d Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_ite_intro_1 
      (@cl (= (not (= b (ite c b a)))
              (and (not (= b (ite c b a)))
                   (ite c 
                        (= b (ite c b a)) 
                        (= a (ite c b a)))))) 
      :rule ite_intro)

(step $test_ite_intro_2 
      (@cl
       (= (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))
          (and (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))
               (ite (p f1)
                    (= f4 (ite (p f1) f4 f2)) 
                    (= f2 (ite (p f1) f4 f2)))))) 
      :rule ite_intro)

(step $test_ite_intro_3
      (@cl (= (= a (ite b c d)) 
              (and (= a (ite b c d)) 
                   (ite b (= c (ite b c d)) (= d (ite b c d)))))) :rule ite_intro)

;-------------------------
; $normalize_single_clause
;-------------------------

(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)


(step $test_$normalize_single_clause_1 true 
      :rule $assert_eq 
      :args (($normalize_single_clause 
              (@cl (not (not p)) (not q)))

             (@cl p (not q))))

(step $test_$normalize_single_clause_2 true 
      :rule $assert_eq 
      :args (($normalize_single_clause 
              (@cl (not q) (not (not p))))

             (@cl (not q) p)))

(step $test_$normalize_single_clause_3 true 
      :rule $assert_eq 
      :args (($normalize_single_clause 
              (@cl (not q) (not (not p)) (not (not r))))

             (@cl (not q) p r)))

(step $test_$normalize_single_clause_4 true 
      :rule $assert_eq 
      :args (($normalize_single_clause 
              (@cl (not (not p)) (not q) (not (not r))))

             (@cl p (not q) r)))

;-------------------------
; $normalize_clauses
;-------------------------

(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)


(step $test_$normalize_clauses_1 true 
      :rule $assert_eq 
      :args (($normalize_clauses 
              (and (@cl (not (not p)) (not q))
                   (@cl (not (not q)) r)))

             (and (@cl p (not q))
                  (@cl q r))))

(step $test_$normalize_clauses_2 true 
      :rule $assert_eq 
      :args (($normalize_clauses 
              (and (@cl (not (not p)) (not q))
                   (@cl (not (not q)) r)
                   (@cl q r)))

             (and (@cl p (not q))
                  (@cl q r)
                  (@cl q r))))

(step $test_$normalize_clauses_3 true 
      :rule $assert_eq 
      :args (($normalize_clauses 
              (and (@cl (not (not p)) (not q))
                   (@cl (not (not q)) r)
                   (@cl (not (not q)) (not r))))

             (and (@cl p (not q))
                  (@cl q r)
                  (@cl q (not r)))))

(step $test_$normalize_clauses_4 true 
      :rule $assert_eq 
      :args (($normalize_clauses 
              (and (@cl (not (not p)) (not q))
                   (@cl (not (not q)) r)
                   (@cl (not (not q)) (not r))
                   (@cl p)))

             (and (@cl p (not q))
                  (@cl q r)
                  (@cl q (not r))
                  (@cl p))))

;-------------------------
; $remove_pivot_from_clause
;-------------------------

(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)


(step $test_$remove_pivot_from_clause_1 true 
      :rule $assert_eq 
      :args (($remove_pivot_from_clause 
              (not (not p))
              (@cl (not (not p)) (not q)))

             (@cl (not q))))

(step $test_$remove_pivot_from_clause_2 true 
      :rule $assert_eq 
      :args (($remove_pivot_from_clause 
              (not (not p))
              (@cl r (not (not p)) (not q)))

             (@cl r (not q))))

(step $test_$remove_pivot_from_clause_3 true 
      :rule $assert_eq 
      :args (($remove_pivot_from_clause 
              (not (not p))
              (@cl (not (not p))))

             @empty_cl))

(step $test_$remove_pivot_from_clause_4 true 
      :rule $assert_eq 
      :args (($remove_pivot_from_clause 
              (not (not p))
              (@cl q r (not (not p))))

             (@cl q r)))

(step $test_$remove_pivot_from_clause_5 true 
      :rule $assert_eq 
      :args (($remove_pivot_from_clause 
              p
              (@cl q r p (not (not p))))

             (@cl q r (not (not p)))))

