; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_$get_ite_terms_1 true 
      :rule $assert_eq 
      :args (($get_ite_terms (not (= b (ite c b a))))

             (@varlist (ite c b a))))

(step $test_$get_ite_terms_2 true 
      :rule $assert_eq 
      :args (($get_ite_terms (=> (and (p f1) 
                                     (or (= f1 f2) 
                                         (not (= (ite (p f1) f4 f2) f3)))) 
                                (p f3)))

             (@varlist (ite (p f1) f4 f2))))

;-----------------
; $check_ite_intro
;-----------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_$check_ite_intro_1 true 
      :rule $assert_eq 
      :args (($check_ite_intro (not (= b (ite c b a)))
                               (not (= b (ite c b a)))
                               (and (ite c 
                                         (= b (ite c b a)) 
                                         (= a (ite c b a)))))

             true))

(step $test_$check_ite_intro_2 true 
      :rule $assert_eq 
      :args (($check_ite_intro 
              (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))

              (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))

              (and (ite (p f1)
                        (= f4 (ite (p f1) f4 f2)) 
                        (= f2 (ite (p f1) f4 f2)))))

             true))

;-----------------
; ite_intro
;-----------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_ite_intro_1 
      (@cl (= (not (= b (ite c b a)))
                      (and (not (= b (ite c b a)))
                           (ite c 
                                (= b (ite c b a)) 
                                (= a (ite c b a)))))) 
      :rule ite_intro)

(step $test_ite_intro_2 
      (@cl
       (= (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))
          (and (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))
               (ite (p f1)
                    (= f4 (ite (p f1) f4 f2)) 
                    (= f2 (ite (p f1) f4 f2)))))) 
      :rule ite_intro)

;-----------------
; not_equiv1
;-----------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)

; Taken from VeriT certificates
(assume premise_1 (@cl (not (= a b))))

(step $test_not_equiv1_1 
      (@cl a b)
      :rule not_equiv1
      :premises (premise_1))

(assume premise_2 (@cl (not (= (or a true) b))))

(step $test_not_equiv1_2
      (@cl (or a true) b)
      :rule not_equiv1
      :premises (premise_2))

(assume premise_3 (@cl (not (= (or a true) (and b false)))))

(step $test_not_equiv1_3
      (@cl (or a true) (and b false))
      :rule not_equiv1
      :premises (premise_3))

;-----------------
; not_equiv2
;-----------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

; Taken from VeriT certificates
(assume premise_1 (@cl (not (= a b))))

(step $test_not_equiv2_1 
      (@cl (not a) (not b))
      :rule not_equiv2
      :premises (premise_1))

(assume premise_2 (@cl (not (= (or a true) b))))

(step $test_not_equiv2_2
      (@cl (not (or a true)) (not b))
      :rule not_equiv2
      :premises (premise_2))

(assume premise_3 (@cl (not (= (or a true) (and b false)))))

(step $test_not_equiv2_3
      (@cl (not (or a true)) (not (and b false)))
      :rule not_equiv2
      :premises (premise_3))

;-----------------
; not_symm
;-----------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)

; Taken from VeriT certificates
(assume premise_not_symm_1 (@cl (not (= a b))))

(step $test_not_symm_1 
      (@cl (not (= b a)))
      :rule not_symm
      :premises (premise_not_symm_1))

(assume premise_not_symm_2 (@cl (not (= (or a true) b))))

(step $test_not_symm_2
      (@cl (not (= b (or a true))))
      :rule not_symm
      :premises (premise_not_symm_2))

(assume premise_not_symm_3 (@cl (not (= (or a true) (and b false)))))

(step $test_not_symm_3
      (@cl (not (= (and b false) (or a true))))
      :rule not_symm
      :premises (premise_not_symm_3))


