      :args (($extract_bool_variables (@varlist x1 x3 x2))

             (@varlist x1 x3)))

(step $test_$extract_bool_variables_2c true 
      :rule $assert_eq 
      :args (($extract_bool_variables (@varlist x2 x1 x3))

             (@varlist x1 x3)))

(define x1 () (eo::var "x1" Bool))
(define x2 () (eo::var "x2" Int))
(define x3 () (eo::var "x3" Bool))
