      :args (($instantiate_bool_terms_rec (and x1
                                                   (exists ((x1 Bool) (x2 Bool) (y1 Int)
                                                       (y2 Int) (x3 Bool))
                                                      (or (= y1 y2) (and x1 x2 x3)))))
             
             (and x1
                  (exists ((y1 Int) (y2 Int)) 
                     (or (or (= y1 y2) (and false false false))
                         (or (= y1 y2) (and true false false))
                         (or (= y1 y2) (and false true false))
                         (or (= y1 y2) (and true true false))
                         (or (= y1 y2) (and false false true))
                         (or (= y1 y2) (and true false true))
                         (or (= y1 y2) (and false true true))
                         (or (= y1 y2) (and true true true)))))))

(step $test_$instantiate_bool_terms_rec_10 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (and (forall ((x1 Bool) (x2 Bool) (y1 Int)
                                                            (x3 Bool))
                                                           (or x1 x2 x3))
                                                   (exists ((x1 Bool) (x2 Bool) (y1 Int)
                                                       (y2 Int) (x3 Bool))
                                                      (or (= y1 y2) (and x1 x2 x3)))))
             
             (and (forall ((y1 Int)) 
                     (and (or false false false)
                          (or true false false)
                          (or false true false)
                          (or true true false)
                          (or false false true)
                          (or true false true)
                          (or false true true)
                          (or true true true)))
                  (exists ((y1 Int) (y2 Int)) 
                     (or (or (= y1 y2) (and false false false))
                         (or (= y1 y2) (and true false false))
                         (or (= y1 y2) (and false true false))
                         (or (= y1 y2) (and true true false))
                         (or (= y1 y2) (and false false true))
                         (or (= y1 y2) (and true false true))
                         (or (= y1 y2) (and false true true))
                         (or (= y1 y2) (and true true true)))))))

(step $test_$instantiate_bool_terms_rec_11 true 
      :rule $assert_eq 
      :args (($instantiate_bool_terms_rec (and
                                               x1
                                               (forall ((x1 Bool) (x2 Bool) (y1 Int)
                                                        (x3 Bool))
                                                       (or x1 x2 x3))
                                               (exists ((x1 Bool) (x2 Bool) (y1 Int)
                                                   (y2 Int) (x3 Bool))
                                                  (or (= y1 y2) (and x1 x2 x3)))))
             
             (and 
              x1
              (forall ((y1 Int)) 
                      (and (or false false false)
                           (or true false false)
                           (or false true false)
                           (or true true false)
                           (or false false true)
                           (or true false true)
                           (or false true true)
                           (or true true true)))
              (exists ((y1 Int) (y2 Int)) 
                 (or (or (= y1 y2) (and false false false))
                     (or (= y1 y2) (and true false false))
                     (or (= y1 y2) (and false true false))
                     (or (= y1 y2) (and true true false))
                     (or (= y1 y2) (and false false true))
                     (or (= y1 y2) (and true false true))
                     (or (= y1 y2) (and false true true))
                     (or (= y1 y2) (and true true true)))))))

