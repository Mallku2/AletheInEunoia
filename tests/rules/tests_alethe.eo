      :rule $assert_eq 
      :args (($find_and_remove_pivot_from_clauses
              p
              (and (@cl r q)
                   (@cl (not (not q)) (not r))
                   (@cl p r)
                   (@cl p (not q))
                   (@cl q r)))

             (@cl r)))

