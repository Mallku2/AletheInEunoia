; Functions
(declare-const f (-> Bool Bool))
(declare-const g (-> Int Bool Bool))
(declare-const h (-> Bool Int Bool))
(declare-const j (-> Bool Int Bool Bool))
(define x () (eo::var "x" Bool))
(define y () (eo::var "y" Int))
(define z () (eo::var "z" Bool))

(assume premise_15 (@cl (f x)))
(step $test_bfun_elim_15
      (@cl (ite x (f true) (f false)))
      :rule bfun_elim
      :premises (premise_15))

(assume premise_16 (@cl (g y x)))
(step $test_bfun_elim_16
      (@cl (ite x (g y true) (g y false)))
      :rule bfun_elim
      :premises (premise_16))

(assume premise_17 (@cl (h x y)))
(step $test_bfun_elim_17
      (@cl (ite x (h true y) (h false y)))
