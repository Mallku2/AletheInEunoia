(include "../../signature/rules/alethe.eo")
(include "../unit_test_services.eo")


; Unit tests for rules that introduce tautologies.

;------------------------------------------
; $ite_intro_check_conjuncts
;------------------------------------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_$ite_intro_check_conjuncts_1 true 
      :rule $assert_eq 
      :args (($ite_intro_check_conjuncts (@varlist (ite a b c))
                                         (and (ite a
                                                   (= (ite a b c) b) 
                                                   (= (ite a b c) c))))

             true))

(step $test_$ite_intro_check_conjuncts_2 true 
      :rule $assert_eq 
      :args (($ite_intro_check_conjuncts (@varlist (ite (p f1) f4 f2))
                                         (and (ite (p f1)
                                                   (= (ite (p f1) f4 f2) f4) 
                                                   (= (ite (p f1) f4 f2) f2))))

             true))

;---------------
; $get_ite_terms
;---------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_$get_ite_terms_1 true 
      :rule $assert_eq 
      :args (($get_ite_terms (not (= b (ite c b a))))

             (@varlist (ite c b a))))

(step $test_$get_ite_terms_2 true 
      :rule $assert_eq 
      :args (($get_ite_terms (=> (and (p f1) 
                                     (or (= f1 f2) 
                                         (not (= (ite (p f1) f4 f2) f3)))) 
                                (p f3)))

             (@varlist (ite (p f1) f4 f2))))

(step $test_$get_ite_terms_3 true 
      :rule $assert_eq 
      :args (($get_ite_terms (= a
                                (ite b
                                     (ite c a b)
                                     (ite c b a))))

             (@varlist (ite b (ite c a b) (ite c b a))
                       (ite c a b)
                       (ite c b a))))

;-----------------
; $check_ite_intro
;-----------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_$check_ite_intro_1 true 
      :rule $assert_eq 
      :args (($check_ite_intro (not (= b (ite c b a)))
                               (not (= b (ite c b a)))
                               (and (ite c 
                                         (= (ite c b a) b) 
                                         (= (ite c b a) a))))

             true))

(step $test_$check_ite_intro_2 true 
      :rule $assert_eq 
      :args (($check_ite_intro 
              (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))

              (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))

              (and (ite (p f1)
                        (= (ite (p f1) f4 f2) f4) 
                        (= (ite (p f1) f4 f2) f2))))

             true))

(declare-const C_tt Bool) 
(declare-const C_tf Bool) 
(declare-const C_ft Bool) 
(declare-const C_ff Bool)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)  

(step $test_$check_ite_intro_3 true 
      :rule $assert_eq 
      :args (($check_ite_intro 
              (= a
                 (ite b
                      (ite c C_tt C_tf)
                      (ite c C_ft C_ff)))

              (= a
                 (ite b
                      (ite c C_tt C_tf)
                      (ite c C_ft C_ff)))

              (and (ite b
                        (= (ite c C_tt C_tf)
                           (ite b
                                (ite c C_tt C_tf)
                                (ite c C_ft C_ff)))
                        (= (ite c C_ft C_ff)
                           (ite b
                                (ite c C_tt C_tf)
                                (ite c C_ft C_ff))))

                   (ite c
                        (= C_tt (ite c C_tt C_tf))
                        (= C_tf (ite c C_tt C_tf)))

                   (ite c
                        (= C_ft (ite c C_ft C_ff))
                        (= C_ff (ite c C_ft C_ff))))
              )

             true)
)

;-----------------
; ite_intro
;-----------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const d Bool)
(declare-const U Type)
(declare-const f1 U)
(declare-const f2 U)
(declare-const f3 U)
(declare-const f4 U)
(declare-const p (-> U Bool))

; Taken from VeriT certificates
(step $test_ite_intro_1 
      (@cl (= (not (= b (ite c b a)))
              (and (not (= b (ite c b a)))
                   (ite c 
                        (= b (ite c b a)) 
                        (= a (ite c b a)))))) 
      :rule ite_intro)

(step $test_ite_intro_2 
      (@cl
       (= (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))
          (and (=> (and (p f1) (or (= f1 f2) (not (= (ite (p f1) f4 f2) f3)))) (p f3))
               (ite (p f1)
                    (= f4 (ite (p f1) f4 f2)) 
                    (= f2 (ite (p f1) f4 f2)))))) 
      :rule ite_intro)

(step $test_ite_intro_3
      (@cl (= (= a (ite b c d)) 
              (and (= a (ite b c d)) 
                   (ite b (= c (ite b c d)) (= d (ite b c d)))))) :rule ite_intro)

;-----------------
; $check_shuffle
;-----------------

; Some constants to build terms, for testing purposes.
(declare-const a Int)
(declare-const b Int)
(declare-const d Bool)
(declare-const e Bool)


; +
(step $test_$check_shuffle_1 true 
      :rule $assert_eq 
      :args (($check_shuffle (+ 1 2) (+ 2 1))

             true))

(step $test_$check_shuffle_2 true 
      :rule $assert_eq 
      :args (($check_shuffle (+ a b) (+ b a a))

             false))

(step $test_$check_shuffle_3 true 
      :rule $assert_eq 
      :args (($check_shuffle (+ a 2) (+ a 2 2))

             false))

(step $test_$check_shuffle_4 true 
      :rule $assert_eq 
      :args (($check_shuffle (+ a b 3) (+ 3 b a))

             true))

(step $test_$check_shuffle_5 true 
      :rule $assert_eq 
      :args (($check_shuffle (+ a 2 2 3) (+ 3 2 a))

             false))

(step $test_$check_shuffle_6 true 
      :rule $assert_eq 
      :args (($check_shuffle (+ a b 2 3) (+ b 3 2 a))

             true))

; *
(step $test_$check_shuffle_8 true 
      :rule $assert_eq 
      :args (($check_shuffle (* a 2) (* 2 a))

             true))

(step $test_$check_shuffle_9 true 
      :rule $assert_eq 
      :args (($check_shuffle (* a b) (* b a a))

             false))

(step $test_$check_shuffle_10 true 
      :rule $assert_eq 
      :args (($check_shuffle (* a 2) (* a 2 2))

             false))

(step $test_$check_shuffle_11 true 
      :rule $assert_eq 
      :args (($check_shuffle (* a 2 3) (* 3 2 a))

             true))

(step $test_$check_shuffle_12 true 
      :rule $assert_eq 
      :args (($check_shuffle (* 1 b b 3) (* 3 b 1))

             false))

(step $test_$check_shuffle_13 true 
      :rule $assert_eq 
      :args (($check_shuffle (* a b 2 3) (* b 3 2 a))

             true))

; or
(step $test_$check_shuffle_14 true 
      :rule $assert_eq 
      :args (($check_shuffle (or true c) (or c true))

             true))

(step $test_$check_shuffle_15 true 
      :rule $assert_eq 
      :args (($check_shuffle (or true c) (or c true true))

             false))

(step $test_$check_shuffle_16 true 
      :rule $assert_eq 
      :args (($check_shuffle (or true c) (or true c c))

             false))

(step $test_$check_shuffle_17 true 
      :rule $assert_eq 
      :args (($check_shuffle (or true c d) (or d c true))

             true))

(step $test_$check_shuffle_18 true 
      :rule $assert_eq 
      :args (($check_shuffle (or true c c d) (or d c true))

             false))

(step $test_$check_shuffle_19 true 
      :rule $assert_eq 
      :args (($check_shuffle (or true c c d) (or c d c true))

             true))

; and
(step $test_$check_shuffle_20 true 
      :rule $assert_eq 
      :args (($check_shuffle (and true c) (and c true))

             true))

(step $test_$check_shuffle_21 true 
      :rule $assert_eq 
      :args (($check_shuffle (and true c) (and c true true))

             false))

(step $test_$check_shuffle_22 true 
      :rule $assert_eq 
      :args (($check_shuffle (and true c) (and true c c))

             false))

(step $test_$check_shuffle_23 true 
      :rule $assert_eq 
      :args (($check_shuffle (and true c d) (and d c true))

             true))

(step $test_$check_shuffle_24 true 
      :rule $assert_eq 
      :args (($check_shuffle (and true c c d) (and d c true))

             false))

(step $test_$check_shuffle_25 true 
      :rule $assert_eq 
      :args (($check_shuffle (and true c c d) (and c d c true))

             true))


;-----------------
; shuffle
;-----------------

; Some constants to build terms, for testing purposes.
(declare-const a Int)
(declare-const b Int)
(declare-const d Bool)
(declare-const e Bool)


; +
(step $test_$check_shuffle_1 
      (@cl (= (+ 1 2) (+ 2 1)))
      :rule shuffle)

(step $test_$check_shuffle_4 
      (@cl (= (+ a b 3) (+ 3 b a)))
      :rule shuffle)

(step $test_$check_shuffle_6 
      (@cl (= (+ a b 2 3) (+ b 3 2 a)))
      :rule shuffle)

; *
(step $test_$check_shuffle_8 
      (@cl (= (* a 2) (* 2 a)))
      :rule shuffle)

(step $test_$check_shuffle_11 
      (@cl (= (* a 2 3) (* 3 2 a)))
      :rule shuffle)

(step $test_$check_shuffle_13 
      (@cl (= (* a b 2 3) (* b 3 2 a)))
      :rule shuffle)

; or
(step $test_$check_shuffle_14 
      (@cl (= (or true c) (or c true)))
      :rule shuffle)

(step $test_$check_shuffle_17 
      (@cl (= (or true c d) (or d c true)))
      :rule shuffle)

(step $test_$check_shuffle_19 
      (@cl (= (or true c c d) (or c d c true)))
      :rule shuffle)

; and
(step $test_$check_shuffle_20 
      (@cl (= (and true c) (and c true)))
      :rule shuffle)

(step $test_$check_shuffle_23 
      (@cl (= (and true c d) (and d c true)))
      :rule shuffle)

(step $test_$check_shuffle_25 
      (@cl (= (and true c c d) (and c d c true)))
      :rule shuffle)


