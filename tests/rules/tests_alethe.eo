                   (or (= y1 y2) (and true false false))
                   (or (= y1 y2) (and false true false))
                   (or (= y1 y2) (and true true false))
                   (or (= y1 y2) (and false false true))
                   (or (= y1 y2) (and true false true))
                   (or (= y1 y2) (and false true true))
                   (or (= y1 y2) (and true true true))))))
