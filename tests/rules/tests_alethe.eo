(assume premise_14 (@cl (and
                         x1
                         (forall ((x1 Bool) (x2 Bool) (y1 Int)
                                  (x3 Bool))
                                 (or x1 x2 x3))
                         (exists ((x1 Bool) (x2 Bool) (y1 Int)
                             (y2 Int) (x3 Bool))
                            (or (= y1 y2) (and x1 x2 x3))))))
(step $test_bfun_elim_14
      (@cl (and 
            x1
            (forall ((y1 Int)) 
                    (and (or false false false)
                         (or true false false)
                         (or false true false)
                         (or true true false)
                         (or false false true)
                         (or true false true)
