(include "../../signature/rules/alethe.eo")

(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(declare-const s Bool)

(step binary (@cl (and p q) (not p) (not q))
  :rule and_neg :args ((and p q)))
(step ternary (@cl (and p q r) (not p) (not q) (not r))
  :rule and_neg :args ((and p q r)))
(step four (@cl (and p q r s) (not p) (not q) (not r) (not s))
  :rule and_neg :args ((and p q r s)))
(step unary (@cl (and p) (not p))
  :rule and_neg :args ((and p)))
(step explicit-true (@cl (and p true) (not p) (not true))
  :rule and_neg :args ((and p true)))
(step explicit-false (@cl (and p false) (not p) (not false))
  :rule and_neg :args ((and p false)))
(step nested (@cl (and p (and q r)) (not p) (not (and q r)))
  :rule and_neg :args ((and p (and q r))))
(step duplicates (@cl (and p p q) (not p) (not p) (not q))
  :rule and_neg :args ((and p p q)))
(step negated-operand (@cl (and (not p) q) (not (not p)) (not q))
  :rule and_neg :args ((and (not p) q)))

; The computed tail has no extra (not true) from the structural terminator.
(define empty-tail () ($negate_conjuncts (eo::nil and Bool))
  :is_eq (eo::nil @cl Bool))
(define negated-tail () ($negate_conjuncts (and p q r))
  :is_eq (@cl (not p) (not q) (not r)))
(define keep-explicit-true () ($negate_conjuncts (and true))
  :is_eq (@cl (not true)))
(define keep-duplicates () ($negate_conjuncts (and p p))
  :is_eq (@cl (not p) (not p)))
(define keep-nested () ($negate_conjuncts (and p (and q r)))
  :is_eq (@cl (not p) (not (and q r))))
