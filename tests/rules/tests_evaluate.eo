(include "../../signature/rules/alethe.eo")

; Unit tests for the evaluate rule: (= t v), where v is the value of the
; constant term t. The right-hand side is given by the certificate, and must be
; the value computed by $eval: the same term, or the same rational for numeric
; literals.

(declare-const p Bool)
(declare-const x Int)
(declare-const r Real)

;------------------
; Boolean operands
;------------------

(step $test_evaluate_not (@cl (= (not true) false)) :rule evaluate :args ((not true)))
(step $test_evaluate_and (@cl (= (and true false true) false)) :rule evaluate :args ((and true false true)))
(step $test_evaluate_or (@cl (= (or false true) true)) :rule evaluate :args ((or false true)))
(step $test_evaluate_implies (@cl (= (=> true false) false)) :rule evaluate :args ((=> true false)))
(step $test_evaluate_xor (@cl (= (xor true true) false)) :rule evaluate :args ((xor true true)))
(step $test_evaluate_ite (@cl (= (ite false true false) false)) :rule evaluate :args ((ite false true false)))
(step $test_evaluate_eq_bool (@cl (= (= true (not false)) true)) :rule evaluate :args ((= true (not false))))
(step $test_evaluate_eq_refl (@cl (= (= p p) true)) :rule evaluate :args ((= p p)))

;---------------------
; Arithmetic operands
;---------------------
; Int results stay Int numerals, as cvc5 prints them.

(step $test_evaluate_add (@cl (= (+ 0 1) 1)) :rule evaluate :args ((+ 0 1)))
(step $test_evaluate_mul (@cl (= (* -1 80) -80)) :rule evaluate :args ((* -1 80)))
(step $test_evaluate_sub (@cl (= (- 3 5) -2)) :rule evaluate :args ((- 3 5)))
(step $test_evaluate_neg (@cl (= (- (- 7)) 7)) :rule evaluate :args ((- (- 7))))
(step $test_evaluate_sum (@cl (= (+ 4001 -2499 -749 -649) 104)) :rule evaluate :args ((+ 4001 -2499 -749 -649)))
(step $test_evaluate_nested (@cl (= (+ (* 2 (- 3 1)) (* -1 (+ 1 1))) 2)) :rule evaluate :args ((+ (* 2 (- 3 1)) (* -1 (+ 1 1)))))
(step $test_evaluate_real (@cl (= (+ 1/2 1/2) 1/1)) :rule evaluate :args ((+ 1/2 1/2)))
(step $test_evaluate_eq_arith (@cl (= (= (+ 1 1) 2) true)) :rule evaluate :args ((= (+ 1 1) 2)))

; Order relations.
(step $test_evaluate_lt (@cl (= (< -1 0) true)) :rule evaluate :args ((< -1 0)))
(step $test_evaluate_leq (@cl (= (<= 1 1) true)) :rule evaluate :args ((<= 1 1)))
(step $test_evaluate_gt (@cl (= (> 1 2) false)) :rule evaluate :args ((> 1 2)))
(step $test_evaluate_geq (@cl (= (>= 0 0) true)) :rule evaluate :args ((>= 0 0)))
(step $test_evaluate_not_leq (@cl (= (not (<= 3 (* 2 1))) true)) :rule evaluate :args ((not (<= 3 (* 2 1)))))
(step $test_evaluate_mixed (@cl (= (< 1/2 1) true)) :rule evaluate :args ((< 1/2 1)))

; Division and to_real, as cvc5 prints them: their values are rationals.
(step $test_evaluate_div (@cl (= (/ 1.0 2.0) 1/2)) :rule evaluate :args ((/ 1.0 2.0)))
(step $test_evaluate_div_scaled (@cl (= (* (- (/ 3.0 2.0)) (* (- 2.0) 1)) 3.0)) :rule evaluate :args ((* (- (/ 3.0 2.0)) (* (- 2.0) 1))))
(step $test_evaluate_to_real (@cl (= (to_real 0) 0.0)) :rule evaluate :args ((to_real 0)))
(step $test_evaluate_to_real_sum (@cl (= (+ (to_real 1) 1/2) 3/2)) :rule evaluate :args ((+ (to_real 1) 1/2)))

; cvc5 prints rationals in decimal notation.
(step $test_evaluate_decimal (@cl (= (+ 0.5 0.5) 1.0)) :rule evaluate :args ((+ 0.5 0.5)))
(step $test_evaluate_decimal_half (@cl (= (/ 1.0 2.0) 0.5)) :rule evaluate :args ((/ 1.0 2.0)))
; ... and rational values as quotients or negations.
(step $test_evaluate_quotient_value (@cl (= (* (/ 1.0 7.0) 1.0) (/ 1.0 7.0))) :rule evaluate :args ((* (/ 1.0 7.0) 1.0)))
(step $test_evaluate_negative_value (@cl (= (to_real -1) (- 1.0))) :rule evaluate :args ((to_real -1)))
(step $test_evaluate_negative_quotient (@cl (= (* (- (/ 240.0 89.0)) 3.0) (- (/ 720.0 89.0)))) :rule evaluate :args ((* (- (/ 240.0 89.0)) 3.0)))

;-----------
; Rejection
;-----------
; A term with an uninterpreted operand has no value: $eval stays stuck.

(define $test_evaluate_reject_arith () (eo::is_ok ($eval (+ x 1))) :is_eq false)
(define $test_evaluate_reject_relation () (eo::is_ok ($eval (< x 1))) :is_eq false)
(define $test_evaluate_reject_real () (eo::is_ok ($eval (* 2.0 r))) :is_eq false)
(define $test_evaluate_reject_bool () (eo::is_ok ($eval (and p true))) :is_eq false)
(define $test_evaluate_reject_to_real () (eo::is_ok ($eval (to_real x))) :is_eq false)

; A division by zero has no value either.
(define $test_evaluate_reject_div_zero () (eo::is_ok ($eval (/ 1.0 0.0))) :is_eq false)
; It is not folded, but kept as a term, like an uninterpreted constant.
(define $test_fold_div_zero () ($fold_constants (+ 1 (/ 1.0 0.0))) :is_eq (+ 1 (/ 1.0 0.0)))

; A wrong value is simply a different term.
(define $test_evaluate_wrong_value () (eo::is_eq ($eval (+ 0 1)) 2) :is_eq false)
(define $test_evaluate_wrong_relation () (eo::is_eq ($eval (< 1 0)) true) :is_eq false)
(define $test_evaluate_wrong_decimal () ($eval_matches ($eval (/ 1.0 2.0)) 0.4) :is_eq false)
(define $test_evaluate_wrong_quotient () ($eval_matches ($eval (* (/ 1.0 7.0) 1.0)) (/ 1.0 8.0)) :is_eq false)
(define $test_evaluate_wrong_bool () ($eval_matches ($eval (< 1 0)) true) :is_eq false)
